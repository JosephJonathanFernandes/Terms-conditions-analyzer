# ClauseClear environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# Application
APP_NAME=ClauseClear
APP_ENV=development              # development | production
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=127.0.0.1
PORT=8000
WORKERS=1

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security
SECRET_KEY=change-me-in-production-a-long-random-string-at-least-32-chars
MAX_UPLOAD_SIZE_MB=25
REQUEST_TIMEOUT_SECONDS=30
MAX_EXTRACTED_CHARS=200000

# Rate limiting (requests per minute per IP)
RATE_LIMIT_HEALTH=60
RATE_LIMIT_INGEST=10
RATE_LIMIT_ANALYZE=10
RATE_LIMIT_CHAT=20
RATE_LIMIT_DEFAULT=60

# AI provider (optional). Leave LLM_PROVIDER=none to use rule-based fallback mode.
LLM_PROVIDER=none                # none | ollama | openai-compatible
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Database (SQLite default; set DATABASE_URL to a PostgreSQL connection string later)
DATABASE_URL=sqlite:///./clauseclear.db

# Document retention (days after which uploaded documents are eligible for deletion)
DOCUMENT_RETENTION_DAYS=30

# Export
EXPORT_MAX_CHARS=500000
